{
  "name": "incubapp",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2"
  },
  "lint-staged": {
    "api/**/*.{ts,json}": "node ./api/node_modules/prettier/bin/prettier.cjs --check --config api/.prettierrc",
    "web/src/**/*.{ts,tsx}": "node ./api/node_modules/prettier/bin/prettier.cjs --check --config api/.prettierrc"
  }
}
